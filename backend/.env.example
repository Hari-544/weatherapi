# ============================================
# National Weather Platform - Environment Config
# ============================================

# Application
PROJECT_NAME=National Weather Big Data Analytics Platform
VERSION=1.0.0
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/weather_platform
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/weather_platform
REDIS_URL=redis://localhost:6379/0
MONGO_URL=mongodb://localhost:27017
ELASTICSEARCH_URL=http://localhost:9200

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Origins (comma-separated)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:80"]

# External APIs
OPENWEATHER_API_KEY=your-openweathermap-api-key
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_SECRET=your-twitter-access-secret
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret

# File Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# ML Configuration
FAKE_DETECTION_THRESHOLD=0.7
DUPLICATE_DISTANCE_KM=10.0
DUPLICATE_TIME_WINDOW_HOURS=6
